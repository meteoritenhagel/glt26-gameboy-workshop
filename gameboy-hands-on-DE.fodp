   <draw:page draw:name="page39" draw:style-name="dp3" draw:master-page-name="Image" presentation:presentation-page-layout-name="AL2T1">
    <draw:frame presentation:style-name="pr43" draw:layer="layout" svg:width="25.2cm" svg:height="2.629cm" svg:x="1.3cm" svg:y="0cm" presentation:class="title" presentation:user-transformed="true">
     <draw:text-box>
      <text:p text:style-name="P95">Kontrollstrukturen</text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame presentation:style-name="pr45" draw:text-style-name="P123" draw:layer="layout" svg:width="25.37cm" svg:height="11.505cm" svg:x="1.3cm" svg:y="2.629cm" presentation:class="outline" presentation:user-transformed="true">
     <draw:text-box>
      <text:p><text:span text:style-name="T70">Wir simulieren Case-Statements:</text:span></text:p>
      <text:list text:style-name="L3">
       <text:list-item>
        <text:list>
         <text:list-header>
          <text:p><text:span text:style-name="T70"/></text:p>
         </text:list-header>
        </text:list>
        <text:p><text:span text:style-name="T71"/></text:p>
       </text:list-item>
      </text:list>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr148" draw:text-style-name="P127" draw:layer="layout" svg:width="18.415cm" svg:height="11.278cm" svg:x="3.81cm" svg:y="3.895cm">
     <draw:text-box>
      <text:p text:style-name="P125"><text:span text:style-name="T40">CaseStatement::</text:span></text:p>
      <text:p text:style-name="P125"><text:span text:style-name="T40"><text:tab/></text:span><text:span text:style-name="T39">ld</text:span><text:span text:style-name="T40"> a, [wVariable]</text:span></text:p>
      <text:p text:style-name="P125"><text:span text:style-name="T40"><text:tab/></text:span><text:span text:style-name="T39">cp</text:span><text:span text:style-name="T40"> 0 <text:s text:c="18"/></text:span><text:span text:style-name="T72">; in case [wVariable] == 0</text:span></text:p>
      <text:p text:style-name="P125"><text:span text:style-name="T40"><text:tab/></text:span><text:span text:style-name="T39">jr</text:span><text:span text:style-name="T40"> nz, </text:span><text:span text:style-name="T73">.notZero</text:span><text:span text:style-name="T74"> </text:span></text:p>
      <text:p text:style-name="P126"><text:span text:style-name="T76"><text:tab/></text:span><text:span text:style-name="T42">call </text:span><text:span text:style-name="T79">VariableIsZero</text:span><text:span text:style-name="T43"> <text:s text:c="3"/></text:span><text:span text:style-name="T76">; call subroutine VariableIsZero</text:span></text:p>
      <text:p text:style-name="P126"><text:span text:style-name="T76"><text:tab/></text:span><text:span text:style-name="T42">jr </text:span><text:span text:style-name="T79">.done</text:span></text:p>
      <text:p text:style-name="P125"><text:span text:style-name="T80">.notZero</text:span></text:p>
      <text:p text:style-name="P126"><text:span text:style-name="T41"><text:tab/></text:span><text:span text:style-name="T42">cp</text:span><text:span text:style-name="T43"> 1 <text:s text:c="18"/></text:span><text:span text:style-name="T72">; in case [wVariable] == 1</text:span></text:p>
      <text:p text:style-name="P126"><text:span text:style-name="T81"><text:tab/></text:span><text:span text:style-name="T82">jr</text:span><text:span text:style-name="T83"> nz, </text:span><text:span text:style-name="T79">.notOne</text:span></text:p>
      <text:p text:style-name="P126"><text:span text:style-name="T79"><text:tab/></text:span><text:span text:style-name="T42">call </text:span><text:span text:style-name="T79">VariableIsOne</text:span><text:span text:style-name="T43"> <text:s text:c="4"/></text:span><text:span text:style-name="T76">; call subroutine VariableIsOne</text:span></text:p>
      <text:p text:style-name="P126"><text:span text:style-name="T76"><text:tab/></text:span><text:span text:style-name="T42">jr </text:span><text:span text:style-name="T79">.done</text:span></text:p>
      <text:p text:style-name="P126"><text:span text:style-name="T77">.notOne</text:span></text:p>
      <text:p text:style-name="P126"><text:span text:style-name="T84"><text:tab/></text:span><text:span text:style-name="T42">cp</text:span><text:span text:style-name="T43"> 2 <text:s text:c="18"/></text:span><text:span text:style-name="T75">; in case [wVariable] == 2</text:span></text:p>
      <text:p text:style-name="P126"><text:span text:style-name="T84"><text:tab/></text:span><text:span text:style-name="T42">jr</text:span><text:span text:style-name="T43"> nz, </text:span><text:span text:style-name="T79">.done</text:span><text:span text:style-name="T43"> <text:s text:c="7"/></text:span></text:p>
      <text:p text:style-name="P126"><text:span text:style-name="T43"><text:tab/></text:span><text:span text:style-name="T42">call </text:span><text:span text:style-name="T79">VariableIsTwo</text:span><text:span text:style-name="T43"> <text:s text:c="4"/></text:span><text:span text:style-name="T76">; call subroutine VariableIsTwo</text:span></text:p>
      <text:p text:style-name="P126"><text:span text:style-name="T77">.done</text:span></text:p>
      <text:p text:style-name="P126"><text:span text:style-name="T41"><text:tab/></text:span><text:span text:style-name="T42">ret <text:s/></text:span><text:span text:style-name="T76">; or other exit, like jp, jr, ...</text:span></text:p>
      <text:p text:style-name="P126"><text:span text:style-name="T39"/></text:p>
      <text:p text:style-name="P126"><text:span text:style-name="T76">; ...</text:span></text:p>
     </draw:text-box>
    </draw:frame>
