     <draw:text-box>
      <text:list text:style-name="L3">
       <text:list-header>
        <text:p><text:span text:style-name="T18">Gearboy (GPL-3.0 License): Emulator/Debugger</text:span></text:p>
       </text:list-header>
       <text:list-item>
        <text:p><text:span text:style-name="T19">Installation</text:span><text:span text:style-name="T19"><text:line-break/></text:span><text:span text:style-name="T19">(</text:span><text:span text:style-name="T19"><text:a xlink:href="https://github.com/drhelius/Gearboy/" xlink:type="simple">https://github.com/drhelius/Gearboy/</text:a></text:span><text:span text:style-name="T19">)</text:span></text:p>
        <text:list>
         <text:list-item>
          <text:p><text:span text:style-name="T19">Snap:</text:span><text:span text:style-name="T19"><text:line-break/></text:span><text:span text:style-name="T22">snap install gearboy</text:span></text:p>
         </text:list-item>
         <text:list-item>
          <text:p text:style-name="P93"><text:span text:style-name="T25">Aura:</text:span><text:span text:style-name="T25"><text:line-break/></text:span><text:span text:style-name="T25">siehe </text:span><text:span text:style-name="T25"><text:a xlink:href="https://aur.archlinux.org/packages/gearboy" xlink:type="simple">https://aur.archlinux.org/packages/gearboy</text:a></text:span></text:p>
         </text:list-item>
         <text:list-item>
          <text:p><text:span text:style-name="T19">Direkter Download: </text:span><text:span text:style-name="T19"><text:a xlink:href="https://github.com/drhelius/Gearboy/releases/tag/3.7.5" xlink:type="simple">https://github.com/drhelius/Gearboy/releases/tag/3.7.5</text:a></text:span></text:p>
         </text:list-item>
        </text:list>
