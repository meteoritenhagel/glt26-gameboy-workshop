    <draw:frame draw:style-name="gr161" draw:text-style-name="P135" draw:layer="layout" svg:width="14.732cm" svg:height="7.145cm" svg:x="3.048cm" svg:y="7.62cm">
     <draw:text-box>
      <text:list text:style-name="L1">
       <text:list-item>
        <text:p text:style-name="P100"><text:span text:style-name="T92">Kopieren huge_music/music_weakbeat.asm → src </text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P100"><text:span text:style-name="T92">utils.asm:</text:span></text:p>
        <text:list>
         <text:list-item>
          <text:p text:style-name="P100"><text:span text:style-name="T92">Neue Funktion PlayWeakBeat</text:span></text:p>
         </text:list-item>
         <text:list-item>
          <text:p text:style-name="P100"><text:span text:style-name="T92">Soll schwachen Schlag abspielen (in music_weakbeat.asm)</text:span></text:p>
         </text:list-item>
         <text:list-item>
          <text:p text:style-name="P100"><text:span text:style-name="T92">Push alle Register</text:span></text:p>
         </text:list-item>
         <text:list-item>
          <text:p text:style-name="P100"><text:span text:style-name="T92">Laden des Sounds (siehe state_title.asm)</text:span></text:p>
         </text:list-item>
         <text:list-item>
          <text:p text:style-name="P100"><text:span text:style-name="T92">Pop alle Register</text:span></text:p>
         </text:list-item>
        </text:list>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P100"><text:span text:style-name="T92">Gerne testen!</text:span></text:p>
       </text:list-item>
      </text:list>
     </draw:text-box>
