    <draw:frame draw:style-name="gr149" draw:text-style-name="P130" draw:layer="layout" svg:width="25.654cm" svg:height="1.979cm" svg:x="2.286cm" svg:y="6.315cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T85">Ziel: Den Titelbildschirm verlassen, wenn eine Taste gedrückt wird</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr156" draw:text-style-name="P131" draw:layer="layout" svg:width="16.256cm" svg:height="4.256cm" svg:x="3.048cm" svg:y="8.015cm">
     <draw:text-box>
      <text:list text:style-name="L1">
       <text:list-header>
        <text:p text:style-name="P100"><text:span text:style-name="T86">state_title.asm</text:span></text:p>
        <text:list>
         <text:list-item>
          <text:p text:style-name="P100"><text:span text:style-name="T86">Neue Funktion WaitMultipleVBlankPressStart, welche jedes Frame auf Input überprüft</text:span></text:p>
         </text:list-item>
         <text:list-item>
          <text:p text:style-name="P100"><text:span text:style-name="T86">Wenn Input erkannt wurde, verlassen wir den Title-Screen durch </text:span><text:span text:style-name="T90">ret</text:span></text:p>
         </text:list-item>
        </text:list>
       </text:list-header>
      </text:list>
     </draw:text-box>
    </draw:frame>
