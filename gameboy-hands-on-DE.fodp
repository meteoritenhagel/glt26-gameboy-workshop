     <draw:page-thumbnail draw:style-name="gr121" draw:layer="layout" svg:width="17cm" svg:height="9.56cm" svg:x="2cm" svg:y="2.5cm" draw:page-number="37" presentation:class="page"/>
     <draw:frame presentation:style-name="pr44" draw:text-style-name="P102" draw:layer="layout" svg:width="17cm" svg:height="14cm" svg:x="2cm" svg:y="13cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
    </presentation:notes>
   </draw:page>
   <draw:page draw:name="page38" draw:style-name="dp3" draw:master-page-name="Image" presentation:presentation-page-layout-name="AL2T1">
    <draw:frame presentation:style-name="pr43" draw:layer="layout" svg:width="25.2cm" svg:height="2.629cm" svg:x="1.3cm" svg:y="0cm" presentation:class="title" presentation:user-transformed="true">
     <draw:text-box>
      <text:p text:style-name="P95">Kontrollstrukturen</text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame presentation:style-name="pr45" draw:text-style-name="P123" draw:layer="layout" svg:width="25.37cm" svg:height="11.505cm" svg:x="1.3cm" svg:y="2.629cm" presentation:class="outline" presentation:user-transformed="true">
     <draw:text-box>
      <text:p><text:span text:style-name="T70">Wir simulieren For-Statements:</text:span></text:p>
      <text:list text:style-name="L3">
       <text:list-item>
        <text:list>
         <text:list-header>
          <text:p><text:span text:style-name="T70"/></text:p>
         </text:list-header>
        </text:list>
        <text:p><text:span text:style-name="T71"/></text:p>
       </text:list-item>
      </text:list>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr147" draw:text-style-name="P124" draw:layer="layout" svg:width="18.415cm" svg:height="5.6cm" svg:x="3.81cm" svg:y="4.56cm">
     <draw:text-box>
      <text:p text:style-name="P113"><text:span text:style-name="T40">ForLoop::</text:span></text:p>
      <text:p text:style-name="P111"><text:span text:style-name="T41"><text:tab/></text:span><text:span text:style-name="T42">ld</text:span><text:span text:style-name="T43"> a, 10 <text:s text:c="7"/></text:span><text:span text:style-name="T76">; iterate 10 times</text:span></text:p>
      <text:p text:style-name="P111"><text:span text:style-name="T77">.loop</text:span><text:span text:style-name="T41"> <text:s text:c="10"/></text:span></text:p>
      <text:p text:style-name="P111"><text:span text:style-name="T72"><text:tab/></text:span><text:span text:style-name="T72">; do something</text:span></text:p>
      <text:p text:style-name="P111"><text:span text:style-name="T76"><text:tab/></text:span><text:span text:style-name="T42">dec</text:span><text:span text:style-name="T76"> </text:span><text:span text:style-name="T77">a</text:span></text:p>
      <text:p text:style-name="P111"><text:span text:style-name="T41"><text:tab/></text:span><text:span text:style-name="T42">jr </text:span><text:span text:style-name="T77">nz, </text:span><text:span text:style-name="T78">.loop</text:span></text:p>
      <text:p text:style-name="P111"><text:span text:style-name="T78"><text:tab/></text:span><text:span text:style-name="T42">ret</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr131" draw:text-style-name="P103" draw:layer="layout" svg:width="12.461cm" svg:height="1.407cm" svg:x="0.636cm" svg:y="13.971cm">
     <draw:text-box>
      <text:p><text:page-number>&lt;number&gt;</text:page-number></text:p>
     </draw:text-box>
    </draw:frame>
    <presentation:notes draw:style-name="dp2">
     <draw:page-thumbnail draw:style-name="gr121" draw:layer="layout" svg:width="17cm" svg:height="9.56cm" svg:x="2cm" svg:y="2.5cm" draw:page-number="38" presentation:class="page"/>
     <draw:frame presentation:style-name="pr44" draw:text-style-name="P102" draw:layer="layout" svg:width="17cm" svg:height="14cm" svg:x="2cm" svg:y="13cm" presentation:class="notes" presentation:placeholder="true">
      <draw:text-box/>
     </draw:frame>
