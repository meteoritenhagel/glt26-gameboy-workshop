   <draw:page draw:name="page49" draw:style-name="dp3" draw:master-page-name="Content_20_1_5f__5f__5f__5f_" presentation:presentation-page-layout-name="AL2T1">
    <draw:frame draw:style-name="gr149" draw:text-style-name="P130" draw:layer="layout" svg:width="25.654cm" svg:height="1.979cm" svg:x="2.286cm" svg:y="6.315cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T85">Ziel: Den Titelbildschirm verlassen, wenn eine Taste gedrückt wird</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr158" draw:text-style-name="P135" draw:layer="layout" svg:width="16.256cm" svg:height="7.911cm" svg:x="3.048cm" svg:y="7.62cm">
     <draw:text-box>
      <text:list text:style-name="L1">
       <text:list-item>
        <text:p text:style-name="P100"><text:span text:style-name="T92">constants.inc: Füge zwei Konstanten für die beiden Game-States Title und Game hinzu</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P100"><text:span text:style-name="T92">variables.asm: wNextState</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P100"><text:span text:style-name="T92">Neues File: state_game.asm</text:span></text:p>
        <text:list>
         <text:list-item>
          <text:p text:style-name="P100"><text:span text:style-name="T92">Funktion InitStateGame</text:span></text:p>
         </text:list-item>
        </text:list>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P100"><text:span text:style-name="T92">main.asm: Statt .loop machen wir eine Entscheidung (wNextState) → entweder nach InitStateTitle oder InitStateGame</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P100"><text:span text:style-name="T92">title.asm: Vorm Return laden wir noch den nächsten geplanten State, also Game, nach wNextState</text:span></text:p>
       </text:list-item>
      </text:list>
     </draw:text-box>
    </draw:frame>
    <draw:custom-shape draw:style-name="gr151" draw:text-style-name="P132" draw:layer="layout" svg:width="0.254cm" svg:height="4.572cm" svg:x="2.54cm" svg:y="7.875cm">
     <text:p/>
