    <draw:frame presentation:style-name="pr45" draw:layer="layout" svg:width="25.37cm" svg:height="11.505cm" svg:x="1.3cm" svg:y="2.629cm" presentation:class="outline" presentation:user-transformed="true">
     <draw:text-box>
      <text:list text:style-name="L3">
       <text:list-item>
        <text:p><text:span text:style-name="T5">Simple Architektur</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p><text:span text:style-name="T5">Gut dokumentiert</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p><text:span text:style-name="T5">Mit vielen Geräten abspielbar</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p><text:span text:style-name="T5">Hardware leicht erhältlich</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p><text:span text:style-name="T5">Nostalgie</text:span></text:p>
       </text:list-item>
      </text:list>
     </draw:text-box>
    </draw:frame>
