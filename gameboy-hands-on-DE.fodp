   <draw:page draw:name="page29" draw:style-name="dp3" draw:master-page-name="Image" presentation:presentation-page-layout-name="AL2T1">
    <draw:frame presentation:style-name="pr43" draw:layer="layout" svg:width="25.2cm" svg:height="2.629cm" svg:x="1.3cm" svg:y="0cm" presentation:class="title" presentation:user-transformed="true">
     <draw:text-box>
      <text:p>CPU (Central Processing Unit)</text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame presentation:style-name="pr45" draw:text-style-name="P109" draw:layer="layout" svg:width="19.685cm" svg:height="11.505cm" svg:x="1.27cm" svg:y="3.1cm" presentation:class="outline" presentation:user-transformed="true">
     <draw:text-box>
      <text:list text:style-name="L3">
       <text:list-item>
        <text:p text:style-name="P108"><text:span text:style-name="T15">Sharp SM83</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P108"><text:span text:style-name="T15">16-Bit Addressraum</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P108"><text:span text:style-name="T15">Elemente vom Intel 8080 und Zilog Z80</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P108"><text:span text:style-name="T15">Register: af (Accumulator + Flags), bc, de, hl</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P108"><text:span text:style-name="T15">Flags: </text:span><text:span text:style-name="T35">z</text:span><text:span text:style-name="T15">, n, h, </text:span><text:span text:style-name="T35">c</text:span><text:span text:style-name="T15"><text:line-break/></text:span><text:span text:style-name="T15">(Zero, Subtraction, Half-Carry, Carry)</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P108"><text:span text:style-name="T15">Stack Pointer (SP) und Program Counter (PC)</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P108"><text:span text:style-name="T15">Memory Mapped I/O</text:span></text:p>
       </text:list-item>
      </text:list>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr131" draw:text-style-name="P103" draw:layer="layout" svg:width="12.461cm" svg:height="1.407cm" svg:x="0.636cm" svg:y="13.971cm">
     <draw:text-box>
      <text:p><text:page-number>&lt;number&gt;</text:page-number></text:p>
     </draw:text-box>
    </draw:frame>
