   <draw:page draw:name="page55" draw:style-name="dp3" draw:master-page-name="Content_20_1_5f__5f__5f__5f__5f__5f__5f__5f_" presentation:presentation-page-layout-name="AL2T1">
    <draw:frame draw:style-name="gr149" draw:text-style-name="P130" draw:layer="layout" svg:width="25.654cm" svg:height="1.979cm" svg:x="2.921cm" svg:y="4.754cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T85">Ziel: Spielereingabe → Box wird schwarz</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr166" draw:text-style-name="P135" draw:layer="layout" svg:width="14.732cm" svg:height="9.443cm" svg:x="3.683cm" svg:y="6.059cm">
     <draw:text-box>
      <text:list text:style-name="L1">
       <text:list-item>
        <text:p text:style-name="P100"><text:span text:style-name="T92">Tile Number von leerer Box bzw. voller Box finden</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P100"><text:span text:style-name="T92">state_game.asm:</text:span></text:p>
        <text:list>
         <text:list-item>
          <text:p text:style-name="P100"><text:span text:style-name="T92">PlayerInput als Kopie von PlayMetronome anlegen</text:span></text:p>
         </text:list-item>
         <text:list-item>
          <text:p text:style-name="P100"><text:span text:style-name="T92">Statt WaitMultipleVBlank, neue Funktion WaitMultipleVBlankPlayerInput schreiben (vgl. state_title.asm)</text:span></text:p>
         </text:list-item>
         <text:list-item>
          <text:p text:style-name="P100"><text:span text:style-name="T92">Auf Playerinput prüfen:</text:span></text:p>
          <text:list>
           <text:list-item>
            <text:p text:style-name="P100"><text:span text:style-name="T92">falls ja: PlayStrongBeat und ändere Box auf voll ($20 auf die Adresse addieren geht in nächste Zeile)</text:span></text:p>
           </text:list-item>
           <text:list-item>
            <text:p text:style-name="P100"><text:span text:style-name="T92">falls nein: Mach normal weiter</text:span></text:p>
           </text:list-item>
          </text:list>
         </text:list-item>
        </text:list>
       </text:list-item>
      </text:list>
