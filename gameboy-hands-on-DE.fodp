   <draw:page draw:name="page37" draw:style-name="dp3" draw:master-page-name="Image" presentation:presentation-page-layout-name="AL2T1">
    <draw:frame presentation:style-name="pr43" draw:layer="layout" svg:width="25.2cm" svg:height="2.629cm" svg:x="1.3cm" svg:y="0cm" presentation:class="title" presentation:user-transformed="true">
     <draw:text-box>
      <text:p>Kontrollstrukturen</text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame presentation:style-name="pr45" draw:text-style-name="P123" draw:layer="layout" svg:width="25.37cm" svg:height="11.505cm" svg:x="1.3cm" svg:y="2.629cm" presentation:class="outline" presentation:user-transformed="true">
     <draw:text-box>
      <text:p><text:span text:style-name="T70">Wir simulieren If-Statements:</text:span></text:p>
      <text:list text:style-name="L3">
       <text:list-item>
        <text:list>
         <text:list-header>
          <text:p><text:span text:style-name="T70"/></text:p>
         </text:list-header>
        </text:list>
        <text:p><text:span text:style-name="T71"/></text:p>
       </text:list-item>
      </text:list>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr146" draw:text-style-name="P124" draw:layer="layout" svg:width="22.225cm" svg:height="11.245cm" svg:x="3.81cm" svg:y="3.995cm">
     <draw:text-box>
      <text:p text:style-name="P113"><text:span text:style-name="T40">CheckEqual::</text:span></text:p>
      <text:p text:style-name="P113"><text:span text:style-name="T40"><text:tab/></text:span><text:span text:style-name="T39">ld</text:span><text:span text:style-name="T40"> a, [wVariable]</text:span></text:p>
      <text:p text:style-name="P113"><text:span text:style-name="T40"><text:tab/></text:span><text:span text:style-name="T39">cp</text:span><text:span text:style-name="T40"> 5 <text:s text:c="21"/></text:span><text:span text:style-name="T72">; if [wVariable] == 5</text:span></text:p>
      <text:p text:style-name="P113"><text:span text:style-name="T40"><text:tab/></text:span><text:span text:style-name="T39">call</text:span><text:span text:style-name="T40"> z, </text:span><text:span text:style-name="T73">VariableEqualFive</text:span><text:span text:style-name="T74"> </text:span><text:span text:style-name="T75">; call subroutine VariableEqualFive</text:span></text:p>
      <text:p text:style-name="P113"><text:span text:style-name="T40"><text:tab/></text:span><text:span text:style-name="T39">ret</text:span></text:p>
      <text:p text:style-name="P113"><text:span text:style-name="T39"/></text:p>
      <text:p text:style-name="P111"><text:span text:style-name="T40">CheckLess::</text:span></text:p>
      <text:p text:style-name="P111"><text:span text:style-name="T40"><text:tab/></text:span><text:span text:style-name="T39">ld</text:span><text:span text:style-name="T40"> a, [wVariable]</text:span></text:p>
      <text:p text:style-name="P111"><text:span text:style-name="T40"><text:tab/></text:span><text:span text:style-name="T39">cp</text:span><text:span text:style-name="T40"> 5 <text:s text:c="20"/></text:span><text:span text:style-name="T72">; if [wVariable] &lt; 5</text:span></text:p>
      <text:p text:style-name="P111"><text:span text:style-name="T40"><text:tab/></text:span><text:span text:style-name="T39">call</text:span><text:span text:style-name="T40"> c, </text:span><text:span text:style-name="T73">VariableLessFive</text:span><text:span text:style-name="T74"> </text:span><text:span text:style-name="T75">; call subroutine VariableLessFive</text:span></text:p>
      <text:p text:style-name="P111"><text:span text:style-name="T40"><text:tab/></text:span><text:span text:style-name="T39">ret</text:span></text:p>
      <text:p text:style-name="P111"><text:span text:style-name="T39"/></text:p>
      <text:p text:style-name="P111"><text:span text:style-name="T40">CheckGreaterOrEqual::</text:span></text:p>
      <text:p text:style-name="P111"><text:span text:style-name="T40"><text:tab/></text:span><text:span text:style-name="T39">ld</text:span><text:span text:style-name="T40"> a, [wVariable]</text:span></text:p>
      <text:p text:style-name="P111"><text:span text:style-name="T40"><text:tab/></text:span><text:span text:style-name="T39">cp</text:span><text:span text:style-name="T40"> 5 <text:s text:c="31"/></text:span><text:span text:style-name="T72">; if [wVariable] &gt;= 5</text:span></text:p>
      <text:p text:style-name="P111"><text:span text:style-name="T40"><text:tab/></text:span><text:span text:style-name="T39">call</text:span><text:span text:style-name="T40"> nc, </text:span><text:span text:style-name="T73">VariableGreaterOrEqualFive</text:span><text:span text:style-name="T74"> </text:span><text:span text:style-name="T75">; call subroutine GreaterOrEqualFive</text:span></text:p>
      <text:p text:style-name="P111"><text:span text:style-name="T40"><text:tab/></text:span><text:span text:style-name="T39">ret</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr131" draw:text-style-name="P103" draw:layer="layout" svg:width="12.461cm" svg:height="1.407cm" svg:x="0.636cm" svg:y="13.971cm">
     <draw:text-box>
      <text:p><text:page-number>&lt;number&gt;</text:page-number></text:p>
     </draw:text-box>
    </draw:frame>
