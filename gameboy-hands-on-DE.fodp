    <draw:frame draw:style-name="gr149" draw:text-style-name="P130" draw:layer="layout" svg:width="25.654cm" svg:height="1.979cm" svg:x="2.286cm" svg:y="6.315cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T85">Ziel: Die Grafik für die Spielmechanik anzeigen</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr160" draw:text-style-name="P135" draw:layer="layout" svg:width="13.462cm" svg:height="7.911cm" svg:x="3.048cm" svg:y="7.62cm">
     <draw:text-box>
      <text:list text:style-name="L1">
       <text:list-item>
        <text:p text:style-name="P100"><text:span text:style-name="T92">Verschieben von raw_resources nach project:</text:span></text:p>
        <text:list>
         <text:list-item>
          <text:p text:style-name="P100"><text:span text:style-name="T92">images/charmap.inc → include</text:span></text:p>
         </text:list-item>
         <text:list-item>
          <text:p text:style-name="P100"><text:span text:style-name="T92">images/font.png → res</text:span></text:p>
         </text:list-item>
        </text:list>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P100"><text:span text:style-name="T92">utils.asm: Neue Funktion DrawText, welche Text anzeigt</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P100"><text:span text:style-name="T92">state_game.asm:</text:span></text:p>
        <text:list>
         <text:list-item>
          <text:p text:style-name="P100"><text:span text:style-name="T92">Textdaten anlegen</text:span></text:p>
         </text:list-item>
         <text:list-item>
          <text:p text:style-name="P100"><text:span text:style-name="T92">Texttiles laden ($8800)</text:span></text:p>
         </text:list-item>
         <text:list-item>
          <text:p text:style-name="P100"><text:span text:style-name="T92">Richtige Startposition für Text finden</text:span></text:p>
         </text:list-item>
         <text:list-item>
          <text:p text:style-name="P100"><text:span text:style-name="T92">DrawText aufrufen</text:span></text:p>
         </text:list-item>
        </text:list>
       </text:list-item>
      </text:list>
     </draw:text-box>
    </draw:frame>
