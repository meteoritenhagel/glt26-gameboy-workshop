   <draw:page draw:name="page45" draw:style-name="dp3" draw:master-page-name="Content_20_1_5f__5f_" presentation:presentation-page-layout-name="AL2T1">
    <draw:frame draw:style-name="gr149" draw:text-style-name="P130" draw:layer="layout" svg:width="18.669cm" svg:height="1.979cm" svg:x="2.286cm" svg:y="6.315cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T85">Ziel: Den Title Screen anzeigen</text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr152" draw:text-style-name="P131" draw:layer="layout" svg:width="16.256cm" svg:height="7.911cm" svg:x="3.048cm" svg:y="8.015cm">
     <draw:text-box>
      <text:list text:style-name="L1">
       <text:list-item>
        <text:p text:style-name="P100"><text:span text:style-name="T86">title.png von raw_resources nach project/res kopieren</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P100"><text:span text:style-name="T86">utils.asm: Schreibe die Funktion WaitVBlank</text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P100"><text:span text:style-name="T86">Neues File state_title.asm anlegen</text:span></text:p>
        <text:list>
         <text:list-item>
          <text:p text:style-name="P100"><text:span text:style-name="T86">Schreibe InitStateTitle</text:span></text:p>
         </text:list-item>
         <text:list-item>
          <text:p text:style-name="P100"><text:span text:style-name="T86">WaitVBlank + LCD ausschalten</text:span></text:p>
         </text:list-item>
         <text:list-item>
          <text:p text:style-name="P100"><text:span text:style-name="T86">Tiles ($9000) und Tilemap ($9800) einbinden</text:span></text:p>
         </text:list-item>
         <text:list-item>
          <text:p text:style-name="P100"><text:span text:style-name="T86">Tiles kopieren, dann Tilemap kopieren</text:span></text:p>
         </text:list-item>
         <text:list-item>
          <text:p text:style-name="P100"><text:span text:style-name="T86">LCD einschalten und Palette initialisieren</text:span></text:p>
         </text:list-item>
        </text:list>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P100"><text:span text:style-name="T86">main.asm: InitStateTitle aufrufen</text:span></text:p>
        <text:p text:style-name="P100"><text:span text:style-name="T86"/></text:p>
       </text:list-item>
      </text:list>
     </draw:text-box>
    </draw:frame>
    <draw:custom-shape draw:style-name="gr151" draw:text-style-name="P132" draw:layer="layout" svg:width="0.254cm" svg:height="4.572cm" svg:x="2.54cm" svg:y="7.875cm">
     <text:p/>
     <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:mirror-horizontal="false" draw:mirror-vertical="false" draw:type="rectangle" draw:enhanced-path="M 0 0 L 21600 0 21600 21600 0 21600 0 0 Z N"/>
    </draw:custom-shape>
